# ==============================================================================
# FocalPoint: Production .gitignore
# Next.js 15 (App Router) + Python 3.12 (AWS SAM) + MediaPipe + WebGazer
# ==============================================================================

# Node.js & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.pnp
.pnp.js

# Next.js & Frontend Build Outputs
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts.bak

# Python & Backend Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# AWS SAM & Serverless Deployment Artifacts
.aws-sam/
.serverless/
samconfig.toml.bak

# Environment Variables & Secrets (Zero-Leakage Policy)
.env
.env*.local
*.pem
*.key
*.cert
*.crt
credentials.json
aws_credentials

# Operating System & Editor Artifacts
.DS_Store
.DS_Store?
._*
[Dd]s_[Ss]tore
.ds_store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Strictly Banned HTML Files (Zero-HTML Policy)
*.html

# Testing & Coverage Artifacts
coverage/
.nyc_output/
vitest.config.ts.timestamp-*
